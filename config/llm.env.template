# LLM configuration for RevAI
# Copy this file to /opt/revai/config/llm.env, fill in your values, and never commit it.
#   sudo mkdir -p /opt/revai/config
#   sudo cp config/llm.env.template /opt/revai/config/llm.env

# OpenAI-compatible model name (use the model name your provider exposes)
# Format: string
REVAI_LLM_MODEL=

# OpenAI-compatible base URL. The pipeline appends /chat/completions internally
# only when missing — a full endpoint URL also works.
# Format: URL string
REVAI_LLM_API_URL=

# API key for the above endpoint
# Format: string
REVAI_LLM_API_KEY=

# Reasoning preference (low, medium, high, max, disabled), mapped to the
# provider's supported effort levels or Thinking on/off switch. Leave blank if
# unsupported. Set disabled for providers whose thinking mode is unreliable —
# aborts, timeouts and empty responses retry without thinking automatically.
# Format: string
REVAI_LLM_REASONING=

# Optional: override temperature for LLM judge calls. Read and applied by the
# pipeline; default 0.0 (deterministic). Shipped commented out on purpose: an
# active non-zero value silently makes runs non-reproducible, and no measurement
# has shown a benefit. Uncomment only for a deliberate experiment.
# REVAI_LLM_TEMPERATURE=0.0

# Optional: read timeout (seconds) for LLM judge calls. Default 300.
# Long report prompts at high reasoning effort can exceed shorter timeouts.
# REVAI_LLM_TIMEOUT=300

# Optional: role pins. Each falls back to REVAI_LLM_MODEL when blank, so a
# single-model setup only needs the value above.
#   REVAI_LLM_PLANNER_MODEL  the agentic tool loop (the ReAct planner). Pin a
#                            faster model here - it drives the most calls.
#   REVAI_LLM_VERDICT_MODEL  the judgment role: the quick-scan triage verdict,
#                            the scripted deep-dive judge and the agentic final
#                            judge. Pin the strongest model available here; it
#                            does not move function recovery or the reports.
REVAI_LLM_PLANNER_MODEL=
REVAI_LLM_VERDICT_MODEL=

# Optional: agentic engine for the deep dive (langgraph | custom). Default: langgraph
# REVAI_AGENTIC_ENGINE=langgraph
