# LLM configuration for CADRE-RevAI
# Copy this file to /opt/cadre-v3-tools/llm.env, fill in your values, and never commit it.

# OpenAI-compatible model name
# Format: string (e.g., deepseek-v4-pro, gpt-4o, claude-3-5-sonnet-20240620)
# Example: REVENG_LLM_MODEL=deepseek-v4-pro
REVENG_LLM_MODEL=

# OpenAI-compatible base URL. The pipeline appends /chat/completions internally.
# Format: URL string (must include scheme, no trailing slash, no path)
# Example: REVENG_LLM_API_URL=https://api.deepseek.com
REVENG_LLM_API_URL=

# API key for the above endpoint
# Format: string (typically starts with sk- or similar)
# Example: REVENG_LLM_API_KEY=sk-abc123def456ghi789
REVENG_LLM_API_KEY=

# Reasoning effort (supported by models like o1, deepseek-v4). 
# Format: string (low, medium, high, max) or leave blank if unsupported.
# Example: REVENG_LLM_REASONING=max
REVENG_LLM_REASONING=

# Optional: override temperature for LLM judge calls
REVENG_LLM_TEMPERATURE=0.2
