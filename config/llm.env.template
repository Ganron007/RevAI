# LLM configuration for RevAI
# Copy this file to /opt/revai/config/llm.env, fill in your values, and never commit it.
#   sudo mkdir -p /opt/revai/config
#   sudo cp config/llm.env.template /opt/revai/config/llm.env

# OpenAI-compatible model name (use the model name your provider exposes)
# Format: string
REVAI_LLM_MODEL=

# OpenAI-compatible base URL. The pipeline appends /chat/completions internally
# only when missing — a full endpoint URL also works.
# Format: URL string
REVAI_LLM_API_URL=

# API key for the above endpoint
# Format: string
REVAI_LLM_API_KEY=

# Reasoning effort (low, medium, high, max, disabled) or leave blank if
# unsupported. Set disabled for providers whose thinking mode is unreliable —
# aborts, timeouts and empty responses retry without thinking automatically.
# Format: string
REVAI_LLM_REASONING=

# Optional: override temperature for LLM judge calls
REVAI_LLM_TEMPERATURE=0.2

# Optional: read timeout (seconds) for LLM judge calls. Default 300.
# Long report prompts at high reasoning effort can exceed shorter timeouts.
# REVAI_LLM_TIMEOUT=300

# Optional: agentic planner / verdict models (default to REVAI_LLM_MODEL if blank)
REVAI_LLM_PLANNER_MODEL=
REVAI_LLM_VERDICT_MODEL=

# Optional: agentic engine for the deep dive (langgraph | custom). Default: langgraph
# REVAI_AGENTIC_ENGINE=langgraph
