# LLM configuration for CADRE-RevAI
# Copy this file to llm.env, fill in your values, and never commit llm.env.

# OpenAI-compatible model name (e.g. deepseek-v4-pro, gpt-4o, etc.)
REVENG_LLM_MODEL=

# OpenAI-compatible base URL. The pipeline appends /chat/completions internally.
# Example: https://api.deepseek.com
REVENG_LLM_API_URL=

# API key for the above endpoint
REVENG_LLM_API_KEY=

# Reasoning effort. Use "max" for highest reasoning on supported models.
REVENG_LLM_REASONING=

# Optional: override temperature for LLM judge calls
REVENG_LLM_TEMPERATURE=0.2
