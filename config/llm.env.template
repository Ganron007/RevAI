# LLM configuration for CADRE-RevAI
# Copy this file to /opt/cadre-v3-tools/llm.env, fill in your values, and never commit it.

# OpenAI-compatible model name (use the model name your provider exposes)
# Format: string
REVENG_LLM_MODEL=

# OpenAI-compatible base URL. The pipeline appends /chat/completions internally.
# Use the provider's API base URL (no trailing slash, no /chat/completions suffix).
# Format: URL string
REVENG_LLM_API_URL=

# API key for the above endpoint
# Format: string
REVENG_LLM_API_KEY=

# Reasoning effort (low, medium, high, max) or leave blank if unsupported.
# Format: string
REVENG_LLM_REASONING=

# Optional: override temperature for LLM judge calls
REVENG_LLM_TEMPERATURE=0.2
