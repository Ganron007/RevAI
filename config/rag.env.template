# RAG configuration for CADRE-RevAI
# Copy this file to /opt/cadre-v3-tools/rag.env, fill in your values, and never commit it.

# Enable RAG
# Format: 0 or 1
REVENG_RAG=1

# Backend: only "remote" is supported in this release.
# The remote backend talks to a unified FastAPI embedding + reranker service.
REVENG_RAG_BACKEND=remote

# Unified FastAPI embedding + reranker service URL
# Format: URL string (base URL only, must include scheme, no trailing slash, no path)
# Example: REVENG_REMOTE_EMBED_URL=http://192.168.1.100:8000
REVENG_REMOTE_EMBED_URL=http://localhost:8000

# Embedding model name exposed by the remote service
# Format: string (HuggingFace model ID or explicit name)
# Example: REVENG_EMBED_MODEL=BAAI/bge-m3
REVENG_EMBED_MODEL=BAAI/bge-m3

# Enable hybrid search (BM25 + dense + RRF)
# Format: 0 or 1
REVENG_RAG_HYBRID=1

# Optional: enable cross-encoder reranker by setting the service URL.
# Format: URL string (base URL only, must include scheme, no trailing slash, no path)
# Example: REVENG_RERANKER_URL=http://192.168.1.100:8000
# Leave unset to keep the reranker off (default).
# REVENG_RERANKER_URL=http://localhost:8000

# Optional: enable FAISS HNSW ANN index (off by default; experimental)
REVENG_RAG_ANN=0

