# CADRE-RevAI defaults — RAG OFF
# Copy to /opt/cadre-v3-tools/rag.env only if you intentionally enable RAG.
# The default product path does not require this file.

# Master toggle — keep 0 for LLM-only
REVENG_RAG=0

# Backend: only "remote" is supported when RAG is enabled
REVENG_RAG_BACKEND=remote

# Unified FastAPI embedding + reranker service URL (used only when REVENG_RAG=1)
# Example: REVENG_REMOTE_EMBED_URL=http://192.168.1.100:8000
REVENG_REMOTE_EMBED_URL=http://localhost:8000

REVENG_EMBED_MODEL=BAAI/bge-m3
REVENG_RAG_HYBRID=1
REVENG_RAG_ANN=0

# Optional reranker (leave unset to keep off)
# REVENG_RERANKER_URL=http://localhost:8000
