[Unit]
Description=CADRE-RevAI reranker service
After=network.target

[Service]
Type=simple
User=%I
Environment="REVENG_RERANKER_HOST=0.0.0.0"
Environment="REVENG_RERANKER_PORT=8000"
Environment="REVENG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3"
Environment="REVENG_RERANKER_DEVICE=auto"
WorkingDirectory=/opt/cadre-v3-tools/rag
ExecStart=/usr/bin/python3 /opt/cadre-v3-tools/rag/reranker_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
