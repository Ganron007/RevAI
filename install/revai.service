[Unit]
Description=CADRE-RevAI Flask Pipeline UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=remnux
Group=remnux
WorkingDirectory=/opt/scripts
ExecStart=/usr/bin/python3 /opt/scripts/app.py
Restart=always
RestartSec=5
# product default: LLM-only (tools → evidence pack → LLM). Opt-in RAG via UI or rag.env.
Environment=REVENG_RAG=0
Environment=REVENG_RAG_HYBRID=0
EnvironmentFile=-/opt/cadre-v3-tools/llm.env
EnvironmentFile=-/opt/cadre-v3-tools/rag.env

[Install]
WantedBy=multi-user.target
