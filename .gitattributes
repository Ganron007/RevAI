# Force LF line endings for cross-platform files
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.c text eol=lf
*.java text eol=lf

# Treat binary files as binary
*.pkl binary
*.npy binary
*.index binary
*.png binary
*.jpg binary
*.ico binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
